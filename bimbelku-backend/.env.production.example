APP_NAME=BimbelKu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id

FRONTEND_URL=https://www.example.com
FRONTEND_ORIGINS=https://www.example.com
CORS_MAX_AGE=600

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

CACHE_STORE=database
QUEUE_CONNECTION=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12
# Jangan pasang batas global 720 menit: token login sudah mempunyai expires_at.
# Batas global itu akan memotong fitur ingat perangkat 30 hari.
SANCTUM_TOKEN_PREFIX=bimbelku_prod_
AUTH_SESSION_COOKIE=bimbelku_session
AUTH_SESSION_STANDARD_MINUTES=720
AUTH_SESSION_REMEMBERED_MINUTES=43200
AUTH_SESSION_ADMIN_MINUTES=720
AUTH_SESSION_REFRESH_THRESHOLD_MINUTES=10080

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.example.com/api/auth/google/callback

MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME=${APP_NAME}

# Isi key TEST dahulu untuk pengujian HTTPS. Ganti ke LIVE hanya setelah lulus.
# Semua secret berikut hanya di backend, tidak boleh memakai awalan VITE_.
XENDIT_ENABLED=false
XENDIT_SECRET_KEY=
XENDIT_WEBHOOK_TOKEN=
XENDIT_BASE_URL=https://api.xendit.co
XENDIT_COUNTRY=ID
XENDIT_CURRENCY=IDR
XENDIT_SUCCESS_URL=https://www.example.com/payment?gateway=success
XENDIT_CANCEL_URL=https://www.example.com/payment?gateway=cancelled
# Deadline pembayaran ditetapkan kode PaymentWindow::MINUTES = 60.
# Mengubah variabel ini saja tidak mengubah deadline aplikasi.
XENDIT_SESSION_TTL_MINUTES=60
XENDIT_PAYOUT_API_VERSION=2025-09-01

# Pencairan tutor masih membutuhkan integrasi BankAccountNameVerifier.
# Mengisi XENDIT_SECRET_KEY tidak otomatis mengaktifkan pemeriksaan nama bank.

FEATURE_TEACHER_REPLACEMENT=true
POLICY_VERSION=2026-07-29
PRIMARY_ADMIN_EMAIL=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_DEMO_USERS=false
